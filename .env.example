VITE_SUPABASE_URL=your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_SERVICE_KEY=your-service-key

# Email configuration
VITE_EMAIL_HOST=your-smtp-server
VITE_EMAIL_PORT=465
VITE_EMAIL_USER=your-email-address
VITE_EMAIL_PASS=your-email-password
VITE_EMAIL_FROM="Your App Name <your-email-address>"

# Gun.js P2P relay servers (comma separated)
VITE_GUN_RELAY=https://gun-relay.herokuapp.com/gun,https://relay.gun.eco/gun
