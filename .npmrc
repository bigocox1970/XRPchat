# Increase timeout and retry settings for better reliability in CI/CD
timeout=300000
registry=https://registry.npmjs.org/
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000

# Use legacy peer deps for better compatibility
legacy-peer-deps=true

# Disable audit during install to reduce network calls
audit=false

# Enable long timeout for package installations
progress=false